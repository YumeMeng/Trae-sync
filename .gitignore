# Trae Sync 根级 .gitignore
# 仅排除生成物与依赖目录，绝不忽略源码、锁文件或 Gate 证据

# ---- Node / Vite ----
node_modules/
dist/
*.tsbuildinfo
.vite/

# ---- Rust / Tauri ----
src-tauri/target/
src-tauri/gen/
# .scratch 下各探针工程（rust 等一次性项目）的编译产物同样忽略，防止进库
.scratch/**/target/
**/target/

# ---- 本地开发环境 ----
.env
.env.local
.env.*.local
.scratch/dev-tauri/

# ---- 操作系统杂项 ----
.DS_Store
Thumbs.db

# ---- TRAE 启动临时日志 ----
/debug.log
# 修复 stdio 继承前，被启动的 TRAE 实例把 debug.log 写进了 src-tauri
src-tauri/debug.log

# ---- 敏感与本地材料（推送 GitHub 前确立的红线）----
# .scratch 含真实 HTTP 实测证据与日志（令牌/凭据材料），永不入远端仓库
.scratch/
# Playwright 生成的报告与一次性运行日志
playwright-report/
test-results/
# 构建产物：安装包（exe/msi）与 UI 验收截图，随发布流程另行归档
artifacts/
e2e-run.log
# 本地排障时的 cargo 输出捕获
src-tauri/check.err
src-tauri/err.txt
# lib.rs 的历史遗留副本（本地排障用）
src-tauri/.git-lib-*.rs

# ---- AI 工具本地配置（开源仓库不入库，本地保留）----
.claude/
.codebuddy/
.gemini/
.qoder/
.windsurfrules
CLAUDE.md
CODEBUDDY.md
GEMINI.md
QODER.md

# ---- 根目录一次性开发脚本（历史排障/截图工具，本地保留）----
/step1.ps1
/step2_scan.ps1
/step3_scan.ps1
/copy_pics.ps1
/final_shots.ps1

# Added by cargo

/target
# Added by code-review-graph
.code-review-graph/
